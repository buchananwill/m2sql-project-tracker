    class EAR_Content:::task{
        name: Early Access - Core Buildable Content
        task_type: milestone
        priority: 1
        notes: All buildable content required for Early Access release
    }

    %% ========================================
    %% UTILITIES DOMAIN
    %% ========================================

    class Utilities:::task{
        name: Utilities System
        task_type: milestone
        priority: 2
        notes: Essential services for resort operation
    }

    class Util_Emergency:::task{
        name: Emergency Services
        task_type: 3d_model
        hours_estimate: 100
        priority: 2
        notes: Safety reputation buff
    }

    class Util_SkiSchool:::task{
        name: Ski School
        task_type: 3d_model
        hours_estimate: 80
        priority: 2
        notes: Revenue source
    }

    class Util_Maintenance:::task{
        name: Resort Maintenance Building
        task_type: 3d_model
        hours_estimate: 80
        priority: 1
        notes: Essential - maintains piste quality
    }
}

